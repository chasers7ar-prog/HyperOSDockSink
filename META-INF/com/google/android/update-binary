#!/sbin/sh
# Magisk / KernelSU compatible installer

umask 022
OUTFD=$2
ZIPFILE=$3

ui_print() {
  if [ -n "$OUTFD" ] && [ -e /proc/self/fd/$OUTFD ]; then
    echo "ui_print $1" > /proc/self/fd/$OUTFD
    echo "ui_print" > /proc/self/fd/$OUTFD
  else
    echo "$1"
  fi
}

ui_print "- HyperOSDockSink installing..."

# Detect module install path
MODDIR=/data/adb/modules/HyperOSDockSink

# Clean old install
rm -rf "$MODDIR"
mkdir -p "$MODDIR"

# Extract everything to module dir
unzip -o "$ZIPFILE" -x "META-INF/*" -d "$MODDIR"

# Fallback if above fails (some recoveries)
if [ ! -f "$MODDIR/module.prop" ]; then
  unzip -o "$ZIPFILE" -d "$MODDIR"
  rm -rf "$MODDIR/META-INF"
fi

if [ ! -f "$MODDIR/module.prop" ]; then
  ui_print "! module.prop not found after unzip"
  ui_print "! Zip structure may be wrong"
  exit 1
fi

chmod 755 "$MODDIR/lib/arm64-v8a/libdock_sink.so" 2>/dev/null || true
chmod 644 "$MODDIR/module.prop" 2>/dev/null || true
chmod 644 "$MODDIR/zn_modules.txt" 2>/dev/null || true

ui_print "- Installed to $MODDIR"
ui_print "- Please reboot"
exit 0
